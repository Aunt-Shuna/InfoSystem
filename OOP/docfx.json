{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [
            "OOP/*.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "*.md",
          "toc.yml"
        ]
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appName": "OOP Documentation",
      "_appTitle": "Документация файлового менеджера",
      "_enableSearch": true,
      "pdf": false
    },
    "template": [
      "default",
      "modern"
    ]
  }
}